[0m15:41:51.773864 [debug] [Thread-1 (]: On model.logswintershop.silverTable: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "logswintershop", "target_name": "julien", "node_id": "model.logswintershop.silverTable"} */

  
    

  create  table "postgres"."julien"."silverTable__dbt_tmp"
  
  
    as
  
  (
    SELECT
    logs,

    -- Timestamp (comme tu l'as fait)
    substring(logs FROM '\[(\d{2}/[A-Za-z]{3}/\d{4}:\d{2}:\d{2}:\d{2})') 
        AS timestamp_extrait,

    -- Timestamp converti en vrai type timestamp (optionnel mais très utile)
    to_timestamp(
        substring(logs FROM '\[(\d{2}/[A-Za-z]{3}/\d{4}:\d{2}:\d{2}:\d{2})'),
        'DD/Mon/YYYY:HH24:MI:SS'
    ) AS timestamp_clean,

    -- IP
    substring(logs FROM '^(\d+\.\d+\.\d+\.\d+)') AS ip,

    -- Méthode HTTP
    substring(logs FROM '"(GET|POST|PUT|DELETE|HEAD|OPTIONS)') AS http_method,

    -- URL appelée
    substring(logs FROM '"(?:GET|POST|PUT|DELETE|HEAD|OPTIONS) ([^ ]+)') AS url,

    -- Code HTTP
    substring(logs FROM '" \d{3} (\d{3})')::int AS status_code,

    -- Taille réponse (bytes)
    substring(logs FROM '" \d{3} \d{3} (\d+)')::int AS bytes,

    -- Referer
    substring(logs FROM '"(https?://[^"]+)"') AS referer,

    -- User agent
    substring(logs FROM '"Mozilla[^"]+"$') AS user_agent,

    -- Device type (mobile / desktop)
    CASE
        WHEN logs ILIKE '%iphone%' 
          OR logs ILIKE '%android%' 
          OR logs ILIKE '%mobile%' 
        THEN 'mobile'
        ELSE 'desktop'
    END AS device_type,

    -- OS
    CASE
        WHEN logs ILIKE '%iphone%' OR logs ILIKE '%ios%' THEN 'iOS'
        WHEN logs ILIKE '%android%' THEN 'Android'
        WHEN logs ILIKE '%windows%' THEN 'Windows'
        WHEN logs ILIKE '%linux%' THEN 'Linux'
        WHEN logs ILIKE '%mac os%' THEN 'MacOS'
        ELSE 'Other'
    END AS os,

    -- Browser
    CASE
        WHEN logs ILIKE '%edg/%' THEN 'Edge'
        WHEN logs ILIKE '%chrome/%' THEN 'Chrome'
        WHEN logs ILIKE '%firefox/%' OR logs ILIKE '%librewolf%' THEN 'Firefox'
        WHEN logs ILIKE '%safari/%' THEN 'Safari'
        ELSE 'Other'
    END AS browser

FROM "postgres"."prod"."bronzeTable"
  );
  
